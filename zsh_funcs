function list_lost() {
    git reflog |  awk '{ print $1 }' | xargs gitk
}

function add_remote() {
    git remote add $2 http://github.com/$2/$1.git
    git fetch $2
}

function update_main() {
    git stash
    git checkout main
    git fetch upstream
    git reset --hard upstream/main
}

function stash_init() {
    mkdir $(git rev-parse --show-toplevel)/.stash
}

function stash_note() {
    note=$(git rev-parse --show-toplevel)/.stash/$(git rev-parse --abbrev-ref HEAD)
    touch $note
    read "?Github issue: " issue
    if [ ! -z "$issue" ] && echo "issue $issue" >> $note
    read "?Goal: " goal
    if [ ! -z "$goal" ] && echo $goal >> $note
    git commit --amend
}

function stash_update() {
    note=$(git rev-parse --show-toplevel)/.stash/$(git rev-parse --abbrev-ref HEAD)
    read "?Updates: " update
    if [ ! -z "$update" ] && echo $update >> $note
}

function stash_ls() {
    ls $(git rev-parse --show-toplevel)/.stash
}

function stash_complete() {
    rm $(git rev-parse --show-toplevel)/.stash/$(git rev-parse --abbrev-ref HEAD)
}

function stash_show() {
    cat $(git rev-parse --show-toplevel)/.stash/$(git rev-parse --abbrev-ref HEAD)
    git --no-pager log --pretty=format:%s -n 1 $1
    echo ""

}
